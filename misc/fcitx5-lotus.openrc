name=$RC_SVCNAME
description="Starts ydotoold service"
supervisor="supervise-daemon"
command="/usr/bin/fcitx5-lotus-server"

reload() {
	ebegin "Reloading $RC_SVCNAME"
	/usr/bin/kill -HUP $MAINPID
	eend $?
}
