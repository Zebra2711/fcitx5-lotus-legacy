[Unit]
Description=Fcitx5 Lotus Server for %i
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
# The sockets live in /run/user/<uid>, just like ydotool, so the instance must
# run as the target user. It retries until that user has logged in and the
# runtime directory exists.
User=%i
SupplementaryGroups=input

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_PTRACE

Type=simple

ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-lotus-server -u %i

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target